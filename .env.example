# ============================================================
# TravelMate — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ============================================================

# Supabase Project URL (from Settings > API in your Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (from Settings > API — use the "anon public" key)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Supabase Project Reference ID (found in Settings > General)
VITE_SUPABASE_PROJECT_ID=your-project-id-here
